[Unit]
Description=Latch Telegram bridge - approvals and agent chat in Telegram
Documentation=https://github.com/mhmdxsadk/latch
After=network-online.target latch.service
Wants=network-online.target

[Service]
Type=simple
# Root, because Latch's admin socket only accepts root. The bridge itself
# only talks to Telegram and to that socket; each agent turn runs as the
# agent's own account (agent.user in telegram.yaml), never as root.
User=root
Group=root
ExecStart=/usr/local/bin/latch-telegram serve --config /etc/latch/telegram.yaml
Restart=on-failure
RestartSec=10s

# The bot token comes from token_file in telegram.yaml (a root-only file,
# or a secrets manager's env file with token_key). It never reaches the
# agent. A missing token makes the service exit and retry every 10 seconds,
# so it starts as soon as a secrets manager has written the file.

# Which requests were shown and the conversation list.
StateDirectory=latch-telegram
StateDirectoryMode=0700

# Only what starting and stopping the agent needs: switching to its account
# (SETUID, SETGID) and stopping its processes (KILL).
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
# NoNewPrivileges is deliberately absent: with it, systemd 257 leaves out
# CAP_SETUID and starting the agent as its account fails. Once switched,
# the agent has exactly its account's normal rights.
# /usr, /boot and /etc read-only. Home folders stay writable: the agent
# keeps its sessions and settings there.
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
